{
  "name": "@showcase/purchase-service",
  "version": "0.0.1",
  "private": true,
  "description": "Backend engineering showcase: purchase service",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev:quality": "yarn concurrently --timings --kill-others-on-fail 'yarn lint' 'yarn test'",
    "dev:start:web": "nest start --watch --entryFile web | pino-pretty -t",
    "dev:test:coverage": "yarn test:unit --reporter=junit --outputFile=junit.xml --coverage --coverage.skipFull false",
    "dev:test:watch": "vitest",
    "dev:typeorm": "NODE_OPTIONS='--require ts-node/register' typeorm -d ormconfig",
    "lint": "yarn concurrently --timings 'yarn:lint:*'",
    "lint:audit": "yarn npm audit",
    "lint:depcheck": "knip",
    "lint:eslint": "node_modules/.bin/eslint",
    "lint:tsc": "tsc --pretty --project .",
    "start:web": "node src/web",
    "test": "yarn concurrently --timings 'npm:test:*'",
    "test:integration": "jest --testMatch '**.test.ts'",
    "test:mutation": "TZ=UTC yarn stryker run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@nestjs/cli": "11.0.14",
    "@nestjs/common": "11.1.15",
    "@nestjs/core": "11.1.18",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-fastify": "11.1.17",
    "@nestjs/swagger": "11.2.4",
    "@nestjs/typeorm": "11.0.0",
    "amqplib": "0.10.9",
    "eslint": "9.39.2",
    "nestjs-pino": "4.5.0",
    "nestjs-zod": "5.1.1",
    "oxide.ts": "1.1.0",
    "pg": "8.16.3",
    "pino": "10.1.1",
    "pino-http": "11.0.0",
    "pluralize": "8.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@jest/types": "30.2.0",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.11",
    "@stryker-mutator/core": "9.4.0",
    "@stryker-mutator/vitest-runner": "9.4.0",
    "@stylistic/eslint-plugin": "5.2.0",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.8",
    "@tsconfig/strictest": "2.0.8",
    "@types/amqplib": "0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.7",
    "@vitest/coverage-v8": "4.0.17",
    "concurrently": "9.2.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-better-max-params": "1.0.0",
    "eslint-plugin-check-file": "3.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-perfectionist": "4.15.0",
    "eslint-plugin-sonarjs": "3.0.5",
    "get-port-please": "3.2.0",
    "globals": "17.0.0",
    "jest": "30.2.0",
    "json5": "2.2.3",
    "knip": "5.80.2",
    "pino-pretty": "13.1.3",
    "scriptlint": "3.0.0",
    "testcontainers": "11.11.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.32.1",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.0.4",
    "vitest": "4.0.17"
  },
  "engines": {
    "node": "^24.6.0",
    "yarn": "^4.9.4"
  },
  "engineStrict": true,
  "packageManager": "yarn@4.12.0"
}
